# ChopNow PRODUCTION API environment: a checklist of variables, not a file to deploy.
# Put each value in the hosting provider's secret manager / environment settings. Never commit
# real values, and never copy production secrets to staging or a laptop.
# The API validates all of this at boot and refuses to start on a mistake (services/api/src/config.ts):
# placeholders, http URLs, localhost origins, the mock payment provider, local disk storage,
# log-only push and debug logging are all rejected in production.
# Domains below use chopnow.example as a stand-in (confirm the real ones).

APP_ENV=production
API_PORT=4000
# web on the instances behind the load balancer, worker on exactly one instance (see DEPLOYMENT.md §3).
PROCESS_ROLE=web
LOG_LEVEL=info
TRUST_PROXY=1                                  # one load balancer in front; must match reality
CORS_ALLOWED_ORIGINS=https://vendor.chopnow.example,https://admin.chopnow.example
PUBLIC_API_URL=https://api.chopnow.example
API_DOCS_ENABLED=false
RELEASE=                                       # set by the deploy pipeline (git SHA)

# Database: the APP role (DML only, see database/roles.sql), never the migrator/owner role.
DATABASE_URL=postgresql://chopnow_app:replace-in-secret-manager@db.internal:5432/chopnow?sslmode=require
DATABASE_POOL_MAX=10                           # web instances × this + worker's must stay under the DB limit

# 48+ random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-in-secret-manager
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=replace-in-secret-manager  # sk_live_… (also verifies webhook signatures)
PAYSTACK_BASE_URL=https://api.paystack.co

STORAGE_DRIVER=s3
MEDIA_PUBLIC_BASE_URL=https://media.chopnow.example
S3_ENDPOINT=                                   # empty for AWS S3; provider endpoint for R2 etc.
S3_REGION=auto
S3_BUCKET_PUBLIC=chopnow-prod-public
S3_BUCKET_PRIVATE=chopnow-prod-private
S3_ACCESS_KEY_ID=replace-in-secret-manager
S3_SECRET_ACCESS_KEY=replace-in-secret-manager

PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=                             # if enhanced push security is on

SENTRY_DSN=                                    # strongly recommended in production

RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_ORDER_MAX=10
RATE_LIMIT_PAYMENT_MAX=30
RATE_LIMIT_WEBHOOK_MAX=300

# ChopNow STAGING API environment: a checklist of variables, not a file to deploy.
# Staging mirrors production with test-mode credentials, so real money and real customers are
# never involved. Use separate database, buckets, Paystack TEST keys and JWT secret; nothing is
# shared with production. The API refuses: the mock payment provider, sk_live_ keys, http URLs,
# localhost origins and placeholder secrets.
# Domains below use chopnow.example as a stand-in (confirm the real ones).

APP_ENV=staging
API_PORT=4000
PROCESS_ROLE=all                               # one instance is enough for staging
LOG_LEVEL=debug                                # allowed in staging, refused in production
TRUST_PROXY=1
CORS_ALLOWED_ORIGINS=https://vendor.staging.chopnow.example,https://admin.staging.chopnow.example
PUBLIC_API_URL=https://api.staging.chopnow.example
API_DOCS_ENABLED=true
RELEASE=

DATABASE_URL=postgresql://chopnow_app:replace-in-secret-manager@staging-db.internal:5432/chopnow_staging?sslmode=require
DATABASE_POOL_MAX=10

JWT_ACCESS_SECRET=replace-in-secret-manager    # different from production
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=replace-in-secret-manager  # sk_test_… only
PAYSTACK_BASE_URL=https://api.paystack.co

STORAGE_DRIVER=s3                              # local works in staging only with a persistent volume; prefer s3
MEDIA_PUBLIC_BASE_URL=https://media.staging.chopnow.example
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_PUBLIC=chopnow-staging-public
S3_BUCKET_PRIVATE=chopnow-staging-private
S3_ACCESS_KEY_ID=replace-in-secret-manager
S3_SECRET_ACCESS_KEY=replace-in-secret-manager

PUSH_PROVIDER=expo                             # or log, to keep testers' phones quiet
EXPO_ACCESS_TOKEN=

SENTRY_DSN=                                    # a separate Sentry environment/project from production

# Staging may seed clearly marked test data: npm run db:seed refuses unless APP_ENV is development/test,
# so use the API/admin dashboard (or a test-only DB) to create staging data.

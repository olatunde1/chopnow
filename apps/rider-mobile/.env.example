# Copy to apps/rider-mobile/.env. EXPO_PUBLIC_* values are bundled into the app: never put secrets here.
#
# API address as seen FROM THE DEVICE:
# - Web preview / iOS simulator: http://localhost:4000
# - Android emulator:            http://10.0.2.2:4000
# - Physical phone (Expo Go):    http://<your computer's LAN IP>:4000   (same Wi-Fi network)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

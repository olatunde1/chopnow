# Copy to apps/website/.env. VITE_* values are bundled into the public website: never put secrets here.
# Where "Order now" and the cart icon send people (the customer app on the web, or a download page).
VITE_ORDER_URL=
# Vendor portal (Start selling / Log in buttons).
VITE_VENDOR_PORTAL_URL=http://localhost:5173
# Store listings. Leave empty until the apps are published: the buttons then show "Coming soon".
VITE_CUSTOMER_PLAY_URL=
VITE_CUSTOMER_APP_STORE_URL=
VITE_RIDER_PLAY_URL=
VITE_RIDER_APP_STORE_URL=

# ChopNow environment template.
# Copy to .env for local development. NEVER commit .env or put real secrets in this file.
# Variables marked [server] are read only by services/api and must never be bundled into a client.
# Variables prefixed EXPO_PUBLIC_ / VITE_ are embedded in client bundles, so they must be public values only.
# Staging/production values live in the hosting provider's secret manager, not in files (see docs/DEPLOYMENT.md).

# ---- Application environment [server] ----
APP_ENV=development            # development | test | staging | production
API_PORT=4000
PROCESS_ROLE=all               # all (one process) | web (API + sockets; scale out) | worker (scheduled jobs; run one)
LOG_LEVEL=info                 # fatal | error | warn | info | debug | trace | silent
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174   # vendor-web, admin-web
TRUST_PROXY=0                  # number of reverse proxies in front of the API (1 behind most load balancers)
RATE_LIMIT_AUTH_MAX=20         # sign-in/registration/refresh attempts per IP per 15 minutes
RATE_LIMIT_GLOBAL_MAX=600      # requests per IP per minute
RATE_LIMIT_ORDER_MAX=10        # order placements per customer per 10 minutes (quotes get 12x)
RATE_LIMIT_PAYMENT_MAX=30      # payment starts/checks per customer per 10 minutes
RATE_LIMIT_WEBHOOK_MAX=300     # payment webhooks per IP per minute
API_DOCS_ENABLED=              # serve /v1/openapi.json; empty = on except in production

# ---- Database [server] (Phase 2) ----
# Databases must be UTF-8 (see README). The test database name must contain "test": integration tests truncate it.
DATABASE_URL=postgresql://chopnow:chopnow_dev_password@localhost:5432/chopnow_dev?schema=public
DATABASE_URL_TEST=postgresql://chopnow:chopnow_dev_password@localhost:5432/chopnow_test?schema=public
DATABASE_POOL_MAX=10           # connections per API process; instances x this must stay under the DB limit
# Optional: password for all seeded development accounts (default is in services/api/src/db/seed/dev-seed.ts).
SEED_USER_PASSWORD=

# ---- Authentication [server] (Phase 2) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-random-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# One-time bootstrap for the first ADMIN account (see docs/OPERATIONS_RUNBOOK.md). Leave empty after use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Payments [server] (Phase 5) ----
# Public base URL of this API as seen by customers' browsers (payment callback + mock checkout links).
PUBLIC_API_URL=http://localhost:4000
PAYMENT_PROVIDER=mock          # mock | paystack   ("mock" is development/test only; refused in staging/production)
PAYSTACK_SECRET_KEY=           # sk_test_… (sk_live_… only accepted with APP_ENV=production)
PAYSTACK_BASE_URL=https://api.paystack.co
# Paystack signs webhooks with the secret key (HMAC-SHA512 in x-paystack-signature); no separate webhook secret.
# Dashboard → Settings → API Keys & Webhooks: Webhook URL = $PUBLIC_API_URL/v1/payments/webhooks/paystack,
# Callback URL = $PUBLIC_API_URL/v1/payments/callback

# ---- Object storage [server] (Phase 3/6) ----
STORAGE_DRIVER=local           # local | s3  (S3-compatible: AWS S3, Cloudflare R2, Supabase Storage S3 API, MinIO)
STORAGE_LOCAL_DIR=./storage   # local driver only (development/test; refused in production)
# Public base URL for uploaded images. Default: $PUBLIC_API_URL/media (local driver). Required for s3: your bucket's
# public/CDN URL, e.g. https://media.chopnow.ng. Menu, logo and cover URLs must start with this value.
MEDIA_PUBLIC_BASE_URL=
S3_ENDPOINT=                   # empty for AWS S3; the provider's endpoint for R2/Supabase/MinIO
S3_REGION=auto
S3_BUCKET_PUBLIC=chopnow-public        # food images, logos (public-read)
S3_BUCKET_PRIVATE=chopnow-private      # verification documents (signed URLs only)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=          # server only; never in a VITE_/EXPO_PUBLIC_ variable

# ---- Push notifications [server] (Phase 10) ----
PUSH_PROVIDER=log              # log (development: logs only) | expo (sends through the Expo push service)
EXPO_ACCESS_TOKEN=             # only if "enhanced push security" is enabled for the Expo project

# ---- Maps [server] (optional geocoding; Phase 4) ----
MAPS_PROVIDER=none             # none | google
GOOGLE_MAPS_SERVER_KEY=

# ---- Error monitoring [server] (Phase 10) ----
SENTRY_DSN=                    # empty = error monitoring off
RELEASE=                       # build id shown in error reports, e.g. git SHA

# ---- Client-side public config (safe to embed) ----
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_SENTRY_DSN=
VITE_API_BASE_URL=http://localhost:4000
VITE_SENTRY_DSN=

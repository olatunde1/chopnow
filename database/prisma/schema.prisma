// ChopNow database schema (PostgreSQL 17, Prisma 7).
//
// Conventions
// - Primary keys: UUIDv7 (time-ordered) generated by Prisma.
// - Table names are snake_case (@@map); column names stay camelCase (quote them in raw SQL: "createdAt").
// - Money: Int in kobo (NGN minor units). Never Float. Per-row ceiling is ₦21,474,836.47 (int4);
//   see docs/DATABASE_SCHEMA.md for when to widen to bigint.
// - Percentages: Int basis points (1500 = 15%).
// - Coordinates: Float (double precision). Only stored where operationally needed.
// - Check constraints, partial unique indexes, trigram search indexes and append-only triggers
//   that Prisma cannot express live in the hand-written SQL appended to the migrations.
// - Enum values mirror packages/shared-schemas/src/enums.ts (asserted by a test).

generator client {
  provider            = "prisma-client"
  output              = "../../services/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  VENDOR
  RIDER
  ADMIN
  OPERATIONS
  SUPPORT
  FINANCE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED
  REJECTED
  DELIVERY_EXCEPTION
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH_ON_DELIVERY
}

enum PaymentProvider {
  PAYSTACK
  MOCK
}

/// Status of a single online payment attempt (an order may have several attempts).
enum PaymentAttemptStatus {
  INITIALIZED
  SUCCESSFUL
  FAILED
  ABANDONED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCESSFUL
  FAILED
  REJECTED
}

enum RiderType {
  CORE
  INDEPENDENT
}

enum RiderAvailability {
  OFFLINE
  ONLINE
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  ON_FOOT
}

enum DocumentType {
  CAC_CERTIFICATE
  FOOD_HANDLER_PERMIT
  OWNER_ID
  DRIVERS_LICENCE
  VEHICLE_PAPERS
  RIDER_ID
  OTHER
}

enum DocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DeliveryStatus {
  UNASSIGNED
  OFFERING
  ASSIGNED
  ARRIVED_AT_RESTAURANT
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  /// Accepted earlier, then released by reassignment.
  RELEASED
}

enum CashCollectionStatus {
  PENDING
  COLLECTED
  PARTIALLY_COLLECTED
  NOT_COLLECTED
  WAIVED
}

enum CashReconciliationStatus {
  NOT_DUE
  OUTSTANDING
  PARTIALLY_RECONCILED
  RECONCILED
  WRITTEN_OFF
}

enum DisputeStatus {
  NONE
  OPEN
  RESOLVED
}

enum RemittanceMethod {
  BANK_TRANSFER
  CASH_HANDOVER
}

enum RemittanceStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
}

enum FinancialTransactionType {
  ONLINE_PAYMENT_CAPTURED
  CASH_COLLECTED
  ORDER_SETTLED
  REFUND
  CASH_REMITTED
  PAYOUT
  ADJUSTMENT
}

enum LedgerAccount {
  /// Money held by the payment provider on the platform's behalf.
  PROVIDER_CLEARING
  /// Cash physically held by riders, not yet remitted.
  RIDER_CASH_HELD
  /// Platform bank account.
  PLATFORM_BANK
  /// Customer-paid amounts awaiting order completion.
  CUSTOMER_ORDER_FUNDS
  VENDOR_PAYABLE
  RIDER_PAYABLE
  PLATFORM_COMMISSION_REVENUE
  PLATFORM_DELIVERY_REVENUE
  PLATFORM_SERVICE_FEE_REVENUE
  PROMOTION_EXPENSE
  REFUNDS_PAYABLE
  ADJUSTMENTS
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum EarningType {
  DELIVERY_FEE
  BONUS
  ADJUSTMENT
}

enum EarningStatus {
  CALCULATED
  APPROVED
  SETTLED
  VOIDED
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAYOUT_INITIATED
  PAID
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  INITIATED
  SUCCESSFUL
  FAILED
}

enum PayoutBeneficiary {
  VENDOR
  RIDER
}

enum PromotionType {
  PERCENT_OFF
  FIXED_OFF
  FREE_DELIVERY
}

enum PromotionFunding {
  PLATFORM
  RESTAURANT
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT
  REFUND
  DELIVERY
  ACCOUNT
  OTHER
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased; uniqueness enforced case-insensitively.
  email         String     @unique
  /// E.164, e.g. +2348012345678
  phone         String?    @unique
  passwordHash  String
  fullName      String
  /// Assigned server-side only. Self-registration may only create CUSTOMER, VENDOR or RIDER.
  role          Role
  status        UserStatus @default(ACTIVE)
  /// Bumped on password change / forced logout; access tokens carrying an older value are rejected.
  tokenVersion  Int        @default(0)
  /// Set for staff accounts created with a temporary password: only changing the password is allowed until then.
  mustChangePassword Boolean @default(false)
  failedLoginCount Int     @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  customerProfile    CustomerProfile?
  rider              Rider?             @relation("RiderUser")
  ownedRestaurants   Restaurant[]       @relation("RestaurantOwner")
  approvedRestaurants Restaurant[]      @relation("RestaurantApprover")
  approvedRiders     Rider[]            @relation("RiderApprover")
  sessions           AuthSession[]
  addresses          Address[]
  orders             Order[]
  favourites         FavouriteRestaurant[]
  reviews            Review[]
  notifications      Notification[]
  pushTokens         PushToken[]
  supportTickets     SupportTicket[]    @relation("TicketRequester")
  assignedTickets    SupportTicket[]    @relation("TicketAssignee")
  supportMessages    SupportMessage[]
  auditLogs          AuditLog[]
  orderStatusChanges OrderStatusHistory[]
  idempotencyKeys    IdempotencyKey[]

  @@index([role, status])
  @@map("users")
}

/// One row per refresh token. Rotation: each refresh revokes the presented token and issues a new one
/// in the same family. Presenting an already-revoked token revokes the whole family (theft signal).
model AuthSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  /// SHA-256 of the opaque refresh token. The token itself is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedReason String?
  replacedById String?   @db.Uuid
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

model CustomerProfile {
  userId           String   @id @db.Uuid
  defaultAddressId String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  label        String
  line1        String
  line2        String?
  area         String
  city         String
  landmark     String?
  latitude     Float?
  longitude    Float?
  contactPhone String?
  instructions String?
  /// Soft delete: orders keep a snapshot, but the address list must not show deleted entries.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ───────────────────────────── Restaurants & menus ─────────────────────────────

model Restaurant {
  id                   String         @id @default(uuid(7)) @db.Uuid
  ownerId              String         @db.Uuid
  name                 String
  slug                 String         @unique
  description          String?
  phone                String?
  email                String?
  logoUrl              String?
  coverImageUrl        String?
  addressLine          String
  area                 String
  city                 String
  latitude             Float?
  longitude            Float?
  verificationStatus   ApprovalStatus @default(PENDING)
  verificationNote     String?
  approvedAt           DateTime?
  approvedById         String?        @db.Uuid
  /// Vendor-controlled "open for orders" switch; opening hours still apply.
  isAcceptingOrders    Boolean        @default(false)
  prepTimeMinutes      Int            @default(20)
  minOrderKobo         Int            @default(0)
  deliveryRadiusMeters Int            @default(5000)
  /// Null = use the platform default commission.
  commissionBpsOverride Int?
  ratingAverage        Float?
  ratingCount          Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  owner        User                  @relation("RestaurantOwner", fields: [ownerId], references: [id])
  approvedBy   User?                 @relation("RestaurantApprover", fields: [approvedById], references: [id])
  hours        RestaurantHours[]
  documents    VerificationDocument[]
  categories   MenuCategory[]
  menuItems    MenuItem[]
  orders       Order[]
  favourites   FavouriteRestaurant[]
  reviews      Review[]
  promotions   Promotion[]
  settlements  VendorSettlement[]
  payouts      Payout[]
  ledgerEntries LedgerEntry[]

  @@index([ownerId])
  @@index([verificationStatus, isAcceptingOrders])
  @@map("restaurants")
}

/// Opening windows in restaurant-local minutes from midnight (Africa/Lagos). Several windows per day allowed.
/// Overnight windows are split across two days.
model RestaurantHours {
  id           String @id @default(uuid(7)) @db.Uuid
  restaurantId String @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek    Int
  opensAt      Int
  closesAt     Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek, opensAt])
  @@map("restaurant_hours")
}

/// Verification documents for restaurants and riders. Files live in the PRIVATE bucket; only the
/// storage key is stored and access is via short-lived signed URLs for authorised staff/owners.
model VerificationDocument {
  id           String         @id @default(uuid(7)) @db.Uuid
  restaurantId String?        @db.Uuid
  riderId      String?        @db.Uuid
  type         DocumentType
  storageKey   String         @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  status       DocumentStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?        @db.Uuid
  reviewedAt   DateTime?
  uploadedAt   DateTime       @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rider      Rider?      @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([riderId])
  @@map("verification_documents")
}

model MenuCategory {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @db.Uuid
  name         String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@unique([restaurantId, name])
  @@map("menu_categories")
}

model MenuItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  restaurantId    String    @db.Uuid
  categoryId      String    @db.Uuid
  name            String
  description     String?
  imageUrl        String?
  /// Price when the item has no variants. When variants exist, a variant must be chosen and its price applies.
  priceKobo       Int
  isAvailable     Boolean   @default(true)
  prepTimeMinutes Int?
  sortOrder       Int       @default(0)
  /// Soft delete keeps historical order_items references valid.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory      @relation(fields: [categoryId], references: [id])
  variants   MenuItemVariant[]
  extras     MenuItemExtra[]
  orderItems OrderItem[]

  @@index([restaurantId, categoryId])
  @@map("menu_items")
}

model MenuItemVariant {
  id         String    @id @default(uuid(7)) @db.Uuid
  menuItemId String    @db.Uuid
  name       String
  /// Full price for this variant (not a delta).
  priceKobo  Int
  isDefault  Boolean   @default(false)
  isAvailable Boolean  @default(true)
  sortOrder  Int       @default(0)
  deletedAt  DateTime?

  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([menuItemId])
  @@map("menu_item_variants")
}

model MenuItemExtra {
  id          String    @id @default(uuid(7)) @db.Uuid
  menuItemId  String    @db.Uuid
  name        String
  priceKobo   Int
  maxQuantity Int       @default(1)
  isAvailable Boolean   @default(true)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?

  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderExtras OrderItemExtra[]

  @@index([menuItemId])
  @@map("menu_item_extras")
}

model FavouriteRestaurant {
  userId       String   @db.Uuid
  restaurantId String   @db.Uuid
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@map("favourite_restaurants")
}

// ───────────────────────────── Orders ─────────────────────────────

model Order {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// Human-friendly reference shown to customers and support, e.g. CN-7K3Q9P.
  code            String        @unique
  customerId      String        @db.Uuid
  restaurantId    String        @db.Uuid
  addressId       String?       @db.Uuid
  /// Immutable copy of the delivery address at order time.
  deliveryAddress Json
  deliveryLatitude  Float?
  deliveryLongitude Float?
  status          OrderStatus   @default(PLACED)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)

  // Amounts (kobo), all computed server-side at creation and never recomputed.
  subtotalKobo    Int
  deliveryFeeKobo Int
  serviceFeeKobo  Int
  discountKobo    Int           @default(0)
  totalKobo       Int
  /// Commission rate and amount snapshotted from the rules in force at order time.
  commissionBps   Int
  commissionKobo  Int
  riderEarningKobo Int

  promotionId     String?       @db.Uuid
  customerNote    String?
  /// 4-digit proof-of-delivery PIN, visible only to the ordering customer and staff.
  deliveryPin     String
  /// Client-supplied Idempotency-Key used to create this order (unique per customer).
  idempotencyKey  String
  /// Online orders: restaurant only sees the order once payment is verified (visibleToVendorAt set).
  visibleToVendorAt DateTime?
  acceptDeadlineAt  DateTime?
  /// Set when the restaurant accepts (now + prep time); moved later if the restaurant reports a delay.
  estimatedReadyAt  DateTime?
  placedAt        DateTime      @default(now())
  acceptedAt      DateTime?
  preparingAt     DateTime?
  readyAt         DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  rejectedAt      DateTime?
  cancellationReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        User                 @relation(fields: [customerId], references: [id])
  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id])
  address         Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  promotion       Promotion?           @relation(fields: [promotionId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  refunds         Refund[]
  delivery        Delivery?
  cashCollection  CashCollection?
  financialTransactions FinancialTransaction[]
  riderEarnings   RiderEarning[]
  review          Review?
  promotionRedemption PromotionRedemption?
  supportTickets  SupportTicket[]
  notifications   Notification[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid(7)) @db.Uuid
  orderId             String  @db.Uuid
  menuItemId          String  @db.Uuid
  variantId           String? @db.Uuid
  /// Snapshots preserve what was sold and at what price, even if the menu changes later.
  nameSnapshot        String
  variantNameSnapshot String?
  unitPriceKobo       Int
  quantity            Int
  /// (unitPrice + sum(extra price × extra qty)) × quantity
  lineTotalKobo       Int
  specialInstructions String?

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem         @relation(fields: [menuItemId], references: [id])
  variant  MenuItemVariant? @relation(fields: [variantId], references: [id])
  extras   OrderItemExtra[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemExtra {
  id            String @id @default(uuid(7)) @db.Uuid
  orderItemId   String @db.Uuid
  extraId       String @db.Uuid
  nameSnapshot  String
  unitPriceKobo Int
  /// Quantity per one unit of the parent order item.
  quantity      Int

  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  extra     MenuItemExtra @relation(fields: [extraId], references: [id])

  @@index([orderItemId])
  @@map("order_item_extras")
}

model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  /// Null when the change was made by the system (timeouts, payment webhooks).
  actorUserId String?      @db.Uuid
  actorRole   String
  reason      String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ───────────────────────────── Payments & refunds ─────────────────────────────

/// One online payment attempt. Cash-on-delivery orders are tracked in cash_collections instead.
model Payment {
  id                    String               @id @default(uuid(7)) @db.Uuid
  orderId               String               @db.Uuid
  provider              PaymentProvider
  /// Our unique transaction reference sent to the provider.
  reference             String               @unique
  amountKobo            Int
  currency              String               @default("NGN")
  status                PaymentAttemptStatus @default(INITIALIZED)
  providerTransactionId String?
  authorizationUrl      String?
  channel               String?
  failureReason         String?
  /// Last provider verification response (sanitised; no card data).
  verificationPayload   Json?
  verifiedAt            DateTime?
  paidAt                DateTime?
  /// When the reconciliation sweep last asked the provider about this attempt.
  lastReconciledAt      DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  order                 Order                  @relation(fields: [orderId], references: [id])
  events                PaymentEvent[]
  refunds               Refund[]
  financialTransactions FinancialTransaction[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every webhook delivery / verification result, stored once. (provider, dedupeKey) is unique so
/// repeated webhooks are recorded and ignored rather than processed twice.
model PaymentEvent {
  id             String          @id @default(uuid(7)) @db.Uuid
  paymentId      String?         @db.Uuid
  provider       PaymentProvider
  source         String
  eventType      String
  dedupeKey      String
  signatureValid Boolean
  payload        Json
  processedAt    DateTime?
  processingError String?
  receivedAt     DateTime        @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, dedupeKey])
  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  orderId          String       @db.Uuid
  /// Null for refunds of cash orders (paid back manually).
  paymentId        String?      @db.Uuid
  amountKobo       Int
  reason           String
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?
  failureReason    String?
  /// Whose money the refund comes from, fixed at approval: CUSTOMER_FUNDS (order never completed),
  /// RESTAURANT or PLATFORM (after delivery), UNAPPLIED_PAYMENT (duplicate/mismatched charge).
  chargeTo         String?
  /// MANUAL for cash or provider-less refunds paid by bank transfer; otherwise the payment provider.
  method           String?
  requestedById    String?      @db.Uuid
  approvedById     String?      @db.Uuid
  idempotencyKey   String       @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  processedAt      DateTime?

  order                 Order                  @relation(fields: [orderId], references: [id])
  payment               Payment?               @relation(fields: [paymentId], references: [id])
  financialTransactions FinancialTransaction[]

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ───────────────────────────── Riders & delivery ─────────────────────────────

model Rider {
  id                  String            @id @default(uuid(7)) @db.Uuid
  userId              String            @unique @db.Uuid
  riderType           RiderType         @default(INDEPENDENT)
  verificationStatus  ApprovalStatus    @default(PENDING)
  verificationNote    String?
  approvedAt          DateTime?
  approvedById        String?           @db.Uuid
  availability        RiderAvailability @default(OFFLINE)
  vehicleType         VehicleType
  vehiclePlate        String?
  vehicleDescription  String?
  serviceZone         String            @default("pilot")
  /// Last reported position; optional and only used for dispatch ranking. Not exposed to customers.
  lastLatitude        Float?
  lastLongitude       Float?
  lastSeenAt          DateTime?
  completedDeliveries Int               @default(0)
  ratingAverage       Float?
  ratingCount         Int               @default(0)
  /// Null = platform default outstanding-cash limit.
  cashLimitKoboOverride Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user           User                   @relation("RiderUser", fields: [userId], references: [id])
  approvedBy     User?                  @relation("RiderApprover", fields: [approvedById], references: [id])
  documents      VerificationDocument[]
  deliveries     Delivery[]
  offers         DeliveryOffer[]
  deliveryEvents DeliveryEvent[]
  cashCollections CashCollection[]
  remittances    CashRemittance[]
  earnings       RiderEarning[]
  settlements    RiderSettlement[]
  payouts        Payout[]
  reviews        Review[]
  ledgerEntries  LedgerEntry[]

  @@index([verificationStatus, availability, riderType])
  @@map("riders")
}

model Delivery {
  id                    String         @id @default(uuid(7)) @db.Uuid
  orderId               String         @unique @db.Uuid
  status                DeliveryStatus @default(UNASSIGNED)
  /// The single rider currently responsible. A partial unique index allows each rider only one active delivery.
  currentRiderId        String?        @db.Uuid
  /// Amount the rider must collect (0 for online-paid orders).
  cashToCollectKobo     Int            @default(0)
  dispatchStartedAt     DateTime?
  /// When independent riders were added to the offer pool.
  widenedAt             DateTime?
  /// When operations were alerted that automatic assignment failed.
  dispatchAlertAt       DateTime?
  assignedAt            DateTime?
  arrivedAtRestaurantAt DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  pinVerifiedAt         DateTime?
  pinFailedAttempts     Int            @default(0)
  /// Staff override of proof-of-delivery, always with a reason (audited).
  proofOverrideById     String?        @db.Uuid
  proofOverrideReason   String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  order        Order           @relation(fields: [orderId], references: [id])
  currentRider Rider?          @relation(fields: [currentRiderId], references: [id])
  offers       DeliveryOffer[]
  events       DeliveryEvent[]
  cashCollection CashCollection?
  riderEarnings RiderEarning[]

  @@index([status])
  @@index([currentRiderId])
  @@map("deliveries")
}

model DeliveryOffer {
  id            String      @id @default(uuid(7)) @db.Uuid
  deliveryId    String      @db.Uuid
  riderId       String      @db.Uuid
  tier          RiderType
  status        OfferStatus @default(PENDING)
  offeredAt     DateTime    @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  declineReason String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider    Rider    @relation(fields: [riderId], references: [id])

  @@index([deliveryId, status])
  @@index([riderId, status])
  @@map("delivery_offers")
}

/// Timeline of delivery actions (offered, accepted, arrived, picked up, delivered, failed, reassigned …).
model DeliveryEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  deliveryId  String   @db.Uuid
  riderId     String?  @db.Uuid
  type        String
  actorUserId String?  @db.Uuid
  note        String?
  createdAt   DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider    Rider?   @relation(fields: [riderId], references: [id])

  @@index([deliveryId, createdAt])
  @@map("delivery_events")
}

// ───────────────────────────── Cash on delivery ─────────────────────────────

model CashCollection {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  orderId              String                   @unique @db.Uuid
  deliveryId           String                   @unique @db.Uuid
  /// Rider responsible for collecting (set when assigned; updated on reassignment before pickup).
  riderId              String?                  @db.Uuid
  amountDueKobo        Int
  amountCollectedKobo  Int                      @default(0)
  status               CashCollectionStatus     @default(PENDING)
  collectedAt          DateTime?
  /// Collected but not yet remitted to the platform = amountCollected - amountReconciled.
  amountReconciledKobo Int                      @default(0)
  reconciliationStatus CashReconciliationStatus @default(NOT_DUE)
  disputeStatus        DisputeStatus            @default(NONE)
  disputeNote          String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  order       Order                      @relation(fields: [orderId], references: [id])
  delivery    Delivery                   @relation(fields: [deliveryId], references: [id])
  rider       Rider?                     @relation(fields: [riderId], references: [id])
  allocations CashRemittanceAllocation[]

  @@index([riderId, reconciliationStatus])
  @@map("cash_collections")
}

/// A rider handing collected cash to the platform. Only CONFIRMED remittances reduce the rider's balance.
model CashRemittance {
  id            String           @id @default(uuid(7)) @db.Uuid
  riderId       String           @db.Uuid
  amountKobo    Int
  method        RemittanceMethod
  reference     String?
  status        RemittanceStatus @default(PENDING_CONFIRMATION)
  note          String?
  confirmedById String?          @db.Uuid
  confirmedAt   DateTime?
  createdAt     DateTime         @default(now())

  rider                 Rider                      @relation(fields: [riderId], references: [id])
  allocations           CashRemittanceAllocation[]
  financialTransactions FinancialTransaction[]

  @@index([riderId, status])
  @@map("cash_remittances")
}

model CashRemittanceAllocation {
  id               String @id @default(uuid(7)) @db.Uuid
  remittanceId     String @db.Uuid
  cashCollectionId String @db.Uuid
  amountKobo       Int

  remittance     CashRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  cashCollection CashCollection @relation(fields: [cashCollectionId], references: [id])

  @@unique([remittanceId, cashCollectionId])
  @@map("cash_remittance_allocations")
}

// ───────────────────────────── Ledger, earnings, settlements, payouts ─────────────────────────────

/// A balanced journal entry (sum of debits = sum of credits). Append-only: corrections are new
/// ADJUSTMENT transactions, never updates. idempotencyKey makes each business event post at most once.
model FinancialTransaction {
  id             String                   @id @default(uuid(7)) @db.Uuid
  type           FinancialTransactionType
  idempotencyKey String                   @unique
  orderId        String?                  @db.Uuid
  paymentId      String?                  @db.Uuid
  refundId       String?                  @db.Uuid
  remittanceId   String?                  @db.Uuid
  payoutId       String?                  @db.Uuid
  description    String
  createdById    String?                  @db.Uuid
  createdAt      DateTime                 @default(now())

  order      Order?          @relation(fields: [orderId], references: [id])
  payment    Payment?        @relation(fields: [paymentId], references: [id])
  refund     Refund?         @relation(fields: [refundId], references: [id])
  remittance CashRemittance? @relation(fields: [remittanceId], references: [id])
  payout     Payout?         @relation(fields: [payoutId], references: [id])
  entries    LedgerEntry[]

  @@index([orderId])
  @@index([type, createdAt])
  @@map("financial_transactions")
}

model LedgerEntry {
  id            String          @id @default(uuid(7)) @db.Uuid
  transactionId String          @db.Uuid
  account       LedgerAccount
  direction     LedgerDirection
  amountKobo    Int
  /// Sub-ledger owner for VENDOR_PAYABLE entries.
  restaurantId  String?         @db.Uuid
  /// Sub-ledger owner for RIDER_PAYABLE / RIDER_CASH_HELD entries.
  riderId       String?         @db.Uuid
  createdAt     DateTime        @default(now())

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id])
  restaurant  Restaurant?          @relation(fields: [restaurantId], references: [id])
  rider       Rider?               @relation(fields: [riderId], references: [id])

  @@index([transactionId])
  @@index([account, restaurantId])
  @@index([account, riderId])
  @@map("ledger_entries")
}

model RiderEarning {
  id           String        @id @default(uuid(7)) @db.Uuid
  riderId      String        @db.Uuid
  orderId      String?       @db.Uuid
  deliveryId   String?       @db.Uuid
  type         EarningType
  amountKobo   Int
  status       EarningStatus @default(CALCULATED)
  settlementId String?       @db.Uuid
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  rider      Rider            @relation(fields: [riderId], references: [id])
  order      Order?           @relation(fields: [orderId], references: [id])
  delivery   Delivery?        @relation(fields: [deliveryId], references: [id])
  settlement RiderSettlement? @relation(fields: [settlementId], references: [id])

  @@index([riderId, status])
  @@map("rider_earnings")
}

model VendorSettlement {
  id                String           @id @default(uuid(7)) @db.Uuid
  restaurantId      String           @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  orderCount        Int
  grossSalesKobo    Int
  commissionKobo    Int
  restaurantFundedDiscountKobo Int    @default(0)
  refundDeductionsKobo Int           @default(0)
  adjustmentsKobo   Int              @default(0)
  netPayableKobo    Int
  status            SettlementStatus @default(DRAFT)
  approvedById      String?          @db.Uuid
  approvedAt        DateTime?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  payouts    Payout[]

  @@unique([restaurantId, periodStart, periodEnd])
  @@index([status])
  @@map("vendor_settlements")
}

model RiderSettlement {
  id                  String           @id @default(uuid(7)) @db.Uuid
  riderId             String           @db.Uuid
  periodStart         DateTime
  periodEnd           DateTime
  deliveryCount       Int
  earningsKobo        Int
  /// Unremitted cash held by the rider, netted off the payout (shown separately for transparency).
  cashOffsetKobo      Int              @default(0)
  adjustmentsKobo     Int              @default(0)
  netPayableKobo      Int
  status              SettlementStatus @default(DRAFT)
  approvedById        String?          @db.Uuid
  approvedAt          DateTime?
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  rider    Rider          @relation(fields: [riderId], references: [id])
  earnings RiderEarning[]
  payouts  Payout[]

  @@unique([riderId, periodStart, periodEnd])
  @@index([status])
  @@map("rider_settlements")
}

/// Record of money actually sent (or attempted). In the MVP payouts are executed manually outside
/// the system and recorded here; no third-party transfer API is called.
model Payout {
  id                 String            @id @default(uuid(7)) @db.Uuid
  beneficiary        PayoutBeneficiary
  restaurantId       String?           @db.Uuid
  riderId            String?           @db.Uuid
  vendorSettlementId String?           @db.Uuid
  riderSettlementId  String?           @db.Uuid
  amountKobo         Int
  method             String            @default("MANUAL_BANK_TRANSFER")
  reference          String            @unique
  /// Bank or transfer reference recorded by finance when the transfer is confirmed.
  bankReference      String?
  status             PayoutStatus      @default(PENDING)
  failureReason      String?
  initiatedById      String?           @db.Uuid
  initiatedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  restaurant            Restaurant?            @relation(fields: [restaurantId], references: [id])
  rider                 Rider?                 @relation(fields: [riderId], references: [id])
  vendorSettlement      VendorSettlement?      @relation(fields: [vendorSettlementId], references: [id])
  riderSettlement       RiderSettlement?       @relation(fields: [riderSettlementId], references: [id])
  financialTransactions FinancialTransaction[]

  @@index([status])
  @@map("payouts")
}

// ───────────────────────────── Engagement ─────────────────────────────

model Review {
  id               String       @id @default(uuid(7)) @db.Uuid
  orderId          String       @unique @db.Uuid
  customerId       String       @db.Uuid
  restaurantId     String       @db.Uuid
  riderId          String?      @db.Uuid
  restaurantRating Int
  riderRating      Int?
  comment          String?
  status           ReviewStatus @default(PUBLISHED)
  vendorReply      String?
  vendorRepliedAt  DateTime?
  moderatedById    String?      @db.Uuid
  moderationNote   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order      Order      @relation(fields: [orderId], references: [id])
  customer   User       @relation(fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  rider      Rider?     @relation(fields: [riderId], references: [id])

  @@index([restaurantId, status, createdAt])
  @@map("reviews")
}

model Promotion {
  id               String           @id @default(uuid(7)) @db.Uuid
  /// Stored upper-case.
  code             String           @unique
  description      String
  type             PromotionType
  /// For PERCENT_OFF.
  percentBps       Int?
  /// For FIXED_OFF.
  amountKobo       Int?
  maxDiscountKobo  Int?
  minSubtotalKobo  Int              @default(0)
  /// Null = platform-wide.
  restaurantId     String?          @db.Uuid
  fundedBy         PromotionFunding @default(PLATFORM)
  startsAt         DateTime
  endsAt           DateTime
  usageLimit       Int?
  perCustomerLimit Int              @default(1)
  isActive         Boolean          @default(true)
  createdById      String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  restaurant  Restaurant?           @relation(fields: [restaurantId], references: [id])
  orders      Order[]
  redemptions PromotionRedemption[]

  @@map("promotions")
}

model PromotionRedemption {
  id           String   @id @default(uuid(7)) @db.Uuid
  promotionId  String   @db.Uuid
  orderId      String   @unique @db.Uuid
  customerId   String   @db.Uuid
  discountKobo Int
  /// False once the order is cancelled/rejected, so the use no longer counts toward limits.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@index([promotionId, customerId])
  @@map("promotion_redemptions")
}

model SupportTicket {
  id           String         @id @default(uuid(7)) @db.Uuid
  code         String         @unique
  requesterId  String         @db.Uuid
  orderId      String?        @db.Uuid
  category     TicketCategory
  subject      String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  assignedToId String?        @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  requester  User             @relation("TicketRequester", fields: [requesterId], references: [id])
  assignedTo User?            @relation("TicketAssignee", fields: [assignedToId], references: [id])
  order      Order?           @relation(fields: [orderId], references: [id])
  messages   SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([requesterId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid(7)) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  /// Internal staff notes are never returned to the requester.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  orderId   String?   @db.Uuid
  /// Prevents duplicate notifications for the same event (e.g. "order:<id>:ACCEPTED:<userId>").
  dedupeKey String?   @unique
  readAt    DateTime?
  /// Set once push delivery has been handled (sent, or nothing to send). Null = still to do.
  pushedAt  DateTime?
  pushAttempts Int    @default(0)
  pushError String?
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

model PushToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  disabledAt DateTime?
  createdAt  DateTime       @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ───────────────────────────── Platform operations ─────────────────────────────

/// Runtime business configuration (fees, commission, COD limits, dispatch timings). Changes are audited.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

/// Append-only record of sensitive actions.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   String
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Stored responses for Idempotency-Key requests (order creation, payment init, cash confirmation …).
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  scope          String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Durable background jobs (offer expiry, dispatch widening, accept-deadline checks, payment
/// reconciliation). Workers claim rows with FOR UPDATE SKIP LOCKED.
model BackgroundJob {
  id          String    @id @default(uuid(7)) @db.Uuid
  type        String
  payload     Json
  /// Optional; prevents scheduling the same logical job twice.
  dedupeKey   String?   @unique
  status      JobStatus @default(QUEUED)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@map("background_jobs")
}
